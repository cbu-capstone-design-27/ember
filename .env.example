# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Only local-infra variables for now. App/service variables get added here
# (with placeholder values) as those components land.

# --- Neo4j (infra/docker-compose.yml) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- GitHub App ingestion worker (services/github-ingestion) ---
# Placeholders only. The stub does not call the GitHub API yet.
# No single repository or account is configured here.
GITHUB_APP_ID=
# Private key, one of:
#   1. Path to a PEM file (compose-friendly), e.g. /run/secrets/github-app.pem
#   2. PEM contents, including the BEGIN/END lines (quote the value in this file)
# Do not commit a real key. The stub does not load this yet.
GITHUB_APP_PRIVATE_KEY=
# Webhook HMAC. Leave empty to skip verification locally (the stub logs a warning).
GITHUB_WEBHOOK_SECRET=
GITHUB_INGESTION_PORT=8080

# --- Integrations (not used yet; placeholders) ---
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# SLACK_BOT_TOKEN=
