# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Only local-infra variables for now. App/service variables get added here
# (with placeholder values) as those components land.

# --- Neo4j (infra/docker-compose.yml) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- GitHub App ingestion worker (services/github-ingestion) ---
# App id is not a secret. 5075660 is the ember-ingest App (example only).
GITHUB_APP_ID=5075660
# Preferred: path to the App private key. Do not commit the .pem.
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative when PATH is empty: PEM contents, including BEGIN/END lines.
# GITHUB_APP_PRIVATE_KEY=
# Webhook HMAC. Leave empty to skip verification locally (the stub logs a warning).
GITHUB_WEBHOOK_SECRET=
GITHUB_INGESTION_PORT=8080
# pull_test.py only. The webhook receiver does not read this and does not filter on it.
GITHUB_TEST_REPO=ryan-stoffel/photon

# --- Integrations (not used yet; placeholders) ---
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# SLACK_BOT_TOKEN=
