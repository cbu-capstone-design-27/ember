# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Only local-infra variables for now. App/service variables get added here
# (with placeholder values) as those components land.

# --- Neo4j (infra/docker-compose.yml) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- GitHub App ingestion worker (services/github-ingestion) ---
# App id is not a secret. 5075660 is the ember-ingest App (example only).
GITHUB_APP_ID=5075660
# Preferred: path to the App private key. Do not commit the .pem.
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative when PATH is empty: PEM contents, including BEGIN/END lines.
# GITHUB_APP_PRIVATE_KEY=
# Webhook HMAC. Leave empty to skip verification locally (the stub logs a warning).
GITHUB_WEBHOOK_SECRET=
GITHUB_INGESTION_PORT=8080
# pull_test.py only. The webhook receiver does not read this and does not filter on it.
GITHUB_TEST_REPO=ryan-stoffel/photon
# In-flight REST calls for the full backfill in pull_test.py. Default 32. Allowed 1–80.
# GITHUB_PULL_CONCURRENCY=32

# --- Slack ingestion worker (services/slack-ingestion) ---
# Basic Information -> App Credentials -> Signing Secret. Leave empty to skip
# verification locally (the stub logs a warning).
SLACK_SIGNING_SECRET=
SLACK_INGESTION_PORT=8082
# pull_test.py only. OAuth & Permissions -> Bot User OAuth Token (xoxb-...).
# The webhook receiver does not read it. Never commit a real token.
SLACK_BOT_TOKEN=
# pull_test.py only. One channel id (C.../G...) to read. Empty reads every
# channel the bot is in. Not a filter on the webhook path.
SLACK_TEST_CHANNEL=
# Channels read in parallel by pull_test.py. Default 4. Maximum 16.
# SLACK_PULL_CONCURRENCY=4

# --- Embedding service (services/embedding, EMBER-33) ---
# Compose profile `embedding`; runs on the DGX Spark. Model identity is fixed by
# ADR 0001: changing model, revision, dimension or query template needs a full rebuild.
# Bind to the Spark's LAN address (the one the public IP maps to), never 0.0.0.0.
# Loopback (127.0.0.1) is the safe default for local runs.
EMBEDDING_BIND_ADDR=127.0.0.1
EMBEDDING_PORT=8000
# Generate with: openssl rand -hex 32
EMBEDDING_API_KEY=

# --- Jira ingestion worker (services/jira-ingestion) ---
# Site origin for pull_test.py. No path. The webhook receiver does not read it.
JIRA_BASE_URL=https://example.atlassian.net
# Atlassian account email and API token. pull_test.py only. Never commit a real token.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Webhook HMAC (X-Hub-Signature). Leave empty to skip verification locally (the stub logs a warning).
JIRA_WEBHOOK_SECRET=
JIRA_INGESTION_PORT=8081
# pull_test.py only. Defaults to EMBER when empty. Not a filter on the webhook path.
JIRA_TEST_PROJECT=EMBER
# Parallel REST GETs for pull_test.py. Default 32. Maximum 64.
# JIRA_PULL_CONCURRENCY=32

# --- GitLab ingestion worker (services/gitlab-ingestion) ---
# Webhook signing token from the project or group webhook (whsec_...). Preferred.
# Leave both webhook values empty to skip verification locally (the stub logs a warning).
GITLAB_WEBHOOK_SIGNING_TOKEN=
# Legacy secret token, echoed back in X-Gitlab-Token. Optional. Every one that is set is checked.
GITLAB_WEBHOOK_SECRET_TOKEN=
GITLAB_INGESTION_PORT=8083
# pull.py only (backfill and reconciliation). The webhook receiver never reads these.
# Instance URL, without /api/v4.
GITLAB_BASE_URL=https://gitlab.com
# Group or project access token with the read_api scope. Never commit a real token.
GITLAB_API_TOKEN=
# Project to pull: numeric id or full path (group/project).
GITLAB_PROJECT=
# Parallel note fetches. Default 8. Maximum 32.
# GITLAB_PULL_CONCURRENCY=8

# --- Integrations (not used yet; placeholders) ---
# GITHUB_TOKEN=
