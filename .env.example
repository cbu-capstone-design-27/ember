# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Only local-infra variables for now. App/service variables get added here
# (with placeholder values) as those components land.

# --- Neo4j (infra/docker-compose.yml) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- GitHub ingestion worker (services/github-ingestion) ---
# Leave the secret empty to skip HMAC locally (the stub logs a warning).
GITHUB_WEBHOOK_SECRET=
GITHUB_INGESTION_PORT=8080
GITHUB_REPO=ryan-stoffel/photon

# --- Integrations (not used yet; placeholders) ---
# GITHUB_TOKEN=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# SLACK_BOT_TOKEN=
