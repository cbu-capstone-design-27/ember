# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Only local-infra variables for now. App/service variables get added here
# (with placeholder values) as those components land.

# --- Neo4j (infra/docker-compose.yml) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-locally
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687

# --- Postgres, the ingestion store (infra/docker-compose.yml profile postgres, EMBER-75) ---
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# For workers run on the host. Commented because the compose `web` service reads the same
# variable, and localhost inside its container is not this Postgres.
# DATABASE_URL=postgresql://ember:change-me-locally@localhost:5432/ember?sslmode=disable

# --- GitHub App (services/intake takes its webhooks; services/github-ingestion backfills and enriches) ---
# App id is not a secret. 5075660 is the ember-ingest App (example only).
GITHUB_APP_ID=5075660
# Preferred: path to the App private key. Do not commit the .pem.
GITHUB_APP_PRIVATE_KEY_PATH=
# Alternative when PATH is empty: PEM contents, including BEGIN/END lines.
# GITHUB_APP_PRIVATE_KEY=
# The App's webhook secret. Intake refuses to start without it; any throwaway value works locally.
GITHUB_WEBHOOK_SECRET=
# Host port for the compose intake profile
INTAKE_HOST_PORT=8080
# pull_test.py only. Intake does not read this and does not filter on it.
GITHUB_TEST_REPO=ryan-stoffel/photon
# In-flight REST calls for the full backfill in pull_test.py. Default 32. Allowed 1–80.
# GITHUB_PULL_CONCURRENCY=32

# --- Slack ingestion worker (services/slack-ingestion) ---
# Basic Information -> App Credentials -> Signing Secret. Leave empty to skip
# verification locally (the stub logs a warning).
SLACK_SIGNING_SECRET=
SLACK_INGESTION_PORT=8082
# pull_test.py only. OAuth & Permissions -> Bot User OAuth Token (xoxb-...).
# The webhook receiver does not read it. Never commit a real token.
SLACK_BOT_TOKEN=
# pull_test.py only. One channel id (C.../G...) to read. Empty reads every
# channel the bot is in. Not a filter on the webhook path.
SLACK_TEST_CHANNEL=
# Channels read in parallel by pull_test.py. Default 4. Maximum 16.
# SLACK_PULL_CONCURRENCY=4
# pull_test.py and enrich.py. internal (default) or non_marketplace (history/replies at 1/min, 15 per page,
# for a commercially distributed app not approved for the Slack Marketplace).
# SLACK_RATE_MODE=internal

# --- Slack enrich worker (services/slack-ingestion/enrich.py, EMBER-67) ---
# It reads SLACK_BOT_TOKEN above, and in compose the Postgres section's POSTGRES_PASSWORD; start it with
# --profile postgres --profile slack-enrich.
# Rows enriched at once (1-16; the container's CONCURRENCY) and the fallback poll when no NOTIFY arrives.
# ENRICH_CONCURRENCY=4
# ENRICH_POLL_SECONDS=30

# --- Embedding service (services/embedding, EMBER-33) ---
# Compose profile `embedding`; runs on the DGX Spark. Model identity is fixed by
# ADR 0001: changing model, revision, dimension or query template needs a full rebuild.
# Bind to the Spark's LAN address (the one the public IP maps to), never 0.0.0.0.
# Loopback (127.0.0.1) is the safe default for local runs.
EMBEDDING_BIND_ADDR=127.0.0.1
EMBEDDING_PORT=8000
# Generate with: openssl rand -hex 32
EMBEDDING_API_KEY=

# --- Embed worker (services/embed, EMBER-77) ---
# The embedding service above, as the worker and the MCP server reach it: base URL without /v1,
# the same API key, and its served model name (ADR 0001). EMBEDDING_API_KEY is optional for clients:
# leave it empty for an endpoint without auth, and no Authorization header is sent.
EMBEDDING_URL=http://127.0.0.1:8000
# EMBEDDING_API_KEY above
# The worker defaults to qwen3-embedding-0.6b. Commented because the compose `embedding` service
# reads EMBEDDING_MODEL as the Hugging Face model to serve; set it only in the worker's environment.
# EMBEDDING_MODEL=qwen3-embedding-0.6b

# --- Jira ingestion worker (services/jira-ingestion) ---
# Site origin for pull_test.py. No path. The webhook receiver does not read it.
JIRA_BASE_URL=https://example.atlassian.net
# Atlassian account email and API token. pull_test.py only. Never commit a real token.
JIRA_EMAIL=
JIRA_API_TOKEN=
# Webhook HMAC (X-Hub-Signature). Leave empty to skip verification locally (the stub logs a warning).
JIRA_WEBHOOK_SECRET=
JIRA_INGESTION_PORT=8081
# pull_test.py only. Defaults to EMBER when empty. Not a filter on the webhook path.
JIRA_TEST_PROJECT=EMBER
# Parallel REST GETs for pull_test.py. Default 32. Maximum 64.
# JIRA_PULL_CONCURRENCY=32

# --- GitLab ingestion worker (services/gitlab-ingestion) ---
# Webhook signing token from the project or group webhook (whsec_...). Preferred.
# Leave both webhook values empty to skip verification locally (the stub logs a warning).
GITLAB_WEBHOOK_SIGNING_TOKEN=
# Legacy secret token, echoed back in X-Gitlab-Token. Optional. Every one that is set is checked.
GITLAB_WEBHOOK_SECRET_TOKEN=
GITLAB_INGESTION_PORT=8083
# pull.py (backfill and reconciliation) and enrich.py. The webhook receiver never reads these.
# Instance URL, without /api/v4.
GITLAB_BASE_URL=https://gitlab.com
# Access token with the read_api scope: a group or project token, or a personal one on
# GitLab.com Free (group and project tokens need Premium there). Never commit a real token.
GITLAB_API_TOKEN=
# Project to pull: numeric id or full path (group/project). EMBER-47 test project: 19861191
# (gitlab-org/ruby/gems/gitlab-dangerfiles).
GITLAB_PROJECT=
# Parallel note fetches. Default 8. Maximum 32.
# GITLAB_PULL_CONCURRENCY=8

# --- Web app (apps/web, EMBER-51) ---
# Database: file:<path> (SQLite) or postgres://user:pass@host:5432/db (Postgres). Nothing else changes.
# The compose `web` service defaults to file:/data/ember.db inside its volume.
# DATABASE_URL=file:./data/ember.db
# Signs session cookies. Required. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The address users open the app at (used for cookie and origin checks).
BETTER_AUTH_URL=http://localhost:3000
# WEB_PORT=3000

# --- Integrations (not used yet; placeholders) ---
# GITHUB_TOKEN=
