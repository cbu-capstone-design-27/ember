# Reverse proxy behind the Funnel Ingress (ingress.yaml). Shipped as ConfigMap nginx-conf and rendered
# by the image entrypoint to /etc/nginx/conf.d/default.conf, replacing the welcome-page config. The
# entrypoint substitutes only names that are set in the environment, so nginx's own variables survive.
# To publish another path, add a location; everything not listed is 404.
server {
    listen 80;
    server_name _;
    server_tokens off;

    # Cluster DNS, read from the pod's resolv.conf by the image entrypoint. With the upstream in a
    # variable, nginx looks the Service up at request time instead of at start, so it starts and
    # stays up whether or not the listener (or CoreDNS) is there yet.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=60s ipv6=off;
    resolver_timeout 5s;

    # Probes only
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # GitHub App webhook -> Service github-webhook
    location = /webhook/github {
        limit_except POST { deny all; }
        # Same cap as MAX_BODY_BYTES in services/github-ingestion/envelope.py
        client_max_body_size 8m;
        set $github_webhook github-webhook.ember.svc.cluster.local:8080;
        proxy_pass http://$github_webhook;
        proxy_set_header Host $host;
        proxy_connect_timeout 5s;
        # GitHub drops a delivery that takes longer than 10 seconds
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}
