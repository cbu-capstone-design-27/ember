                },
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "-1": {
                  "text": "No data",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
