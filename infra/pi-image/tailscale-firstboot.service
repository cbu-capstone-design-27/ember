[Unit]
Description=Join the tailnet with the auth key on the boot partition
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
ConditionPathExists=/boot/firmware/tailscale-authkey
# Keep retrying until Wi-Fi, DNS and the clock are all good
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Hostname comes from cloud-init (user-data), which runs before this
ExecStart=/usr/bin/tailscale up --auth-key=file:/boot/firmware/tailscale-authkey --timeout=2m
# Only runs if the join succeeded; also stops this unit from running again
ExecStartPost=/usr/bin/rm -f /boot/firmware/tailscale-authkey
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
