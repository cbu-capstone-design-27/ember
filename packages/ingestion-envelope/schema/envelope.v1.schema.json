{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.v1.schema.json",
  "title": "Ember ingestion envelope v1",
  "description": "One shared envelope for every ingestion source. Source-specific fields live only in payload. Embeddings are not part of this envelope (EMBER-3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "source",
    "time",
    "content_refs",
    "type",
    "metadata",
    "payload"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_native_id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable Ember id for this event. Not a replacement for the source-native id."
        },
        "source_native_id": {
          "type": "string",
          "minLength": 1,
          "description": "Source-native id kept correlatable: Jira key, GitHub owner/repo#number, Slack channel:ts, Teams message id, GitLab project!iid."
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "org", "actor"],
      "properties": {
        "system": {
          "enum": ["github", "jira", "slack", "teams", "gitlab"]
        },
        "org": {
          "type": "string",
          "minLength": 1,
          "description": "Org, site, workspace, or tenant the event came from."
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "description": "Source-native id of the actor who caused the event."
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "ingested_at"],
      "properties": {
        "occurred_at": { "type": "string", "format": "date-time" },
        "ingested_at": { "type": "string", "format": "date-time" }
      }
    },
    "content_refs": {
      "type": "array",
      "description": "URLs or object pointers. Full blobs do not belong in the envelope.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "enum": ["url", "object"] },
          "ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Event kind. Combined with source.system it names the occurrence."
    },
    "metadata": {
      "type": "object",
      "description": "Open bag for small non-content facts. Not a place for blobs or embeddings."
    },
    "payload": {
      "type": "object",
      "description": "Typed source body. Shape is selected by source.system."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "properties": { "system": { "const": "github" } }, "required": ["system"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "number", "title"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "number": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "system": { "const": "jira" } }, "required": ["system"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "project_key", "issue_type", "summary"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "project_key": { "type": "string", "minLength": 1 },
              "issue_type": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "system": { "const": "slack" } }, "required": ["system"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel", "ts"],
            "properties": {
              "channel": { "type": "string", "minLength": 1 },
              "ts": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "system": { "const": "teams" } }, "required": ["system"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["team_id", "channel_id", "message_id"],
            "properties": {
              "team_id": { "type": "string", "minLength": 1 },
              "channel_id": { "type": "string", "minLength": 1 },
              "message_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "properties": { "system": { "const": "gitlab" } }, "required": ["system"] } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_path", "iid", "title"],
            "properties": {
              "project_path": { "type": "string", "minLength": 1 },
              "iid": { "type": "integer", "minimum": 1 },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
